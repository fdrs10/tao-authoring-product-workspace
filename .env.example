# Copy to .env and adjust. NEVER commit real secrets (§12 Cloud Architecture).
APP_ENV=local
PORT=8080
LOG_FORMAT=json
# Local docker-compose:
DATABASE_URL=postgresql+psycopg://tao:tao_dev_password@localhost:54323/tao_authoring
# Cloud SQL (unix socket) example:
# DATABASE_URL=postgresql+psycopg://USER:PASS@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE
# Jira (future direct API ingestion; identity/lineage of SRC-JIRA-001 survives):
# JIRA_BASE_URL=https://oat-sa.atlassian.net
# Source documents (Phase 6): artifacts only — Product Truth stays in PostgreSQL.
# GCS driver activates when SOURCE_DOC_BUCKET is set (google-cloud-storage required):
# SOURCE_DOC_BUCKET=gs://PROJECT-source-documents
# SOURCE_DOC_PREFIX=source-documents
# Local dev fallback driver (default):
# SOURCE_DOC_LOCAL_DIR=./data/source-documents
